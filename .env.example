# Required: OpenRouter API key for LLM chat (free :free models only)
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses (testing / no API key)
LLM_MOCK=false
